properties:
  note.cours:
    displayName: Heures
  note.prerequis:
    displayName: Prérequis
  note.projet:
    displayName: Projet
  note.specialisation:
    displayName: Spécialisation
  note.bloc:
    displayName: Bloc
  note.duration_h:
    displayName: Durée (h)
  note.title:
    displayName: Titre
  file.name:
    displayName: Note
views:
  - type: table
    name: Blocs
    filters:
      and:
        - file.inFolder("01 courses/Theory/blocs")
        - type == "bloc"
    order:
      - file.name
      - cours
      - prerequis
    sort:
      - property: file.name
        direction: ASC
    summaries:
      cours: Sum
