filters:
  and:
    - file.inFolder("01 courses/lectures")
    - file.ext == "md"
    - type != "section"
formulas:
  semaine: if(date_scheduled, date(date_scheduled).format("GGGG-[S]WW"), "")
views:
  - type: kanban-action-planner
    name: Kanban
    order:
      - file.name
      - bloc_gsda
    sort:
      - property: date_scheduled
        direction: ASC
    statuses:
      - Backlog
      - To prepare
      - To check
      - Ready
      - Post-mortem
    calendarMode: false
    triageMode: false
    timelineMode: false
    wbsMode: false
    agendaMode: false
    calendarTab: scheduled
    calendarPanelCollapsed: false
    calendarShowScheduled: true
    calendarShowDeadlines: true
    filterQuery: ""
    calendarRangeOverride: month
    collapsedColumns:
      - Done
      - Backlog
    cardSort: property
    laneGrouping: property
    laneGroupingProperty: formula.semaine
    cardSortProperty: note.date_scheduled
    collapsedLanes:
      - 2026-09-09
      - 2026-09-16
      - 2026-09-17
      - 2026-09-23
      - 2026-S37
      - 2026-S38
      - 2026-S39
  - type: table
    name: Liste
    order:
      - file.name
      - bloc_gsda
      - tache
      - date_scheduled
    sort:
      - property: file.name
        direction: DESC
      - property: tache
        direction: ASC
      - property: bloc_gsda
        direction: ASC
