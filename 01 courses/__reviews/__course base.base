filters:
  and:
    - file.inFolder("01 courses/lectures")
    - file.ext == "md"
    - type == "seance"
    - '!file.path.contains("/_")'
formulas:
  semaine: if(date_scheduled, date(date_scheduled).format("GGGG-[S]WW"), "")
views:
  - type: kanban-action-planner
    name: Kanban
    order:
      - file.name
      - date_scheduled
    sort:
      - property: date_scheduled
        direction: ASC
    statuses:
      - Backlog
      - To prepare
      - To check
      - Ready
      - Post-mortem
      - Post-mortem-done
    calendarMode: false
    triageMode: false
    timelineMode: false
    wbsMode: false
    agendaMode: false
    calendarTab: scheduled
    calendarPanelCollapsed: false
    calendarShowScheduled: true
    calendarShowDeadlines: true
    filterQuery: ""
    calendarRangeOverride: month
    collapsedColumns:
      - Done
      - __unmapped__
      - Post-mortem
      - Backlog
      - Post-mortem-done
    cardSort: property
    laneGrouping: property
    cardSortProperty: note.date_scheduled
    collapsedLanes:
      - 2026-09-09
      - 2026-09-16
      - 2026-09-17
      - 2026-09-23
      - 2026-S37
      - 2026-S38
      - 2026-S39
      - 2026-S40
      - 2026-S41
    showDueCountdown: true
    countdownSource: scheduled
  - type: table
    name: Liste
    order:
      - file.name
      - date_scheduled
      - status
    sort:
      - property: date_scheduled
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 476
      note.date_scheduled: 143
