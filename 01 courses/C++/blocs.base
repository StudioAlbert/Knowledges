properties:
  note.cours:
    displayName: Heures
  note.prerequis:
    displayName: Prérequis
  note.projet:
    displayName: Projet
  note.specialisation:
    displayName: Spécialisation
  note.bloc:
    displayName: Bloc
  note.duration_h:
    displayName: Durée (h)
  note.title:
    displayName: Titre
  file.name:
    displayName: Note
views:
- type: table
  name: Blocs
  filters:
    and:
    - file.inFolder("01 courses/C++/blocs")
    - type == "bloc"
  order:
  - file.name
  - cours
  - prerequis
  - projet
  sort:
  - property: file.name
    direction: ASC
  summaries:
    cours: Sum
  columnSize:
    file.name: 240
    note.cours: 80
- type: table
  name: Heures par bloc
  filters:
    and:
    - file.inFolder("01 courses/C++/cours")
    - type == "course"
  groupBy:
    property: bloc
    direction: ASC
  order:
  - title
  - duration_h
  summaries:
    duration_h: Sum
  columnSize:
    note.title: 260
    note.duration_h: 90
- type: table
  name: Sans bloc
  filters:
    and:
    - file.inFolder("01 courses/C++/cours")
    - type == "course"
    - '!bloc'
  order:
  - file.name
  - title
  - duration_h
- type: table
  name: À compléter
  filters:
    and:
    - file.inFolder("01 courses/C++/cours")
    - type == "course"
    - '!duration_h'
  order:
  - file.name
  - title
  - bloc
  sort:
  - property: bloc
    direction: ASC
