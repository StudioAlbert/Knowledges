filters:
  and:
    - file.inFolder("01 courses/lectures")
    - file.ext == "md"
    - type != "section"
views:
  - type: kanban-action-planner
    name: Kanban
    groupBy:
      property: projet
      direction: ASC
    sort:
      - property: file.name
        direction: ASC
    statuses:
      - Backlog
      - To prepare
      - Ready
      - Done
    calendarMode: false
    triageMode: false
    timelineMode: false
    wbsMode: false
    agendaMode: false
    calendarTab: scheduled
    calendarPanelCollapsed: false
    calendarShowScheduled: true
    calendarShowDeadlines: true
    filterQuery: ""
    calendarRangeOverride: month
    collapsedColumns:
      - Ready
      - Done
      - __unmapped__
      - Backlog
    cardSort: name
    laneGrouping: property
    laneGroupingProperty: note.bloc_gsda
  - type: table
    name: Liste
    groupBy:
      property: bloc_gsda
      direction: ASC
    order:
      - file.name
      - bloc_gsda
      - tache
    sort:
      - property: tache
        direction: ASC
      - property: bloc_gsda
        direction: ASC
