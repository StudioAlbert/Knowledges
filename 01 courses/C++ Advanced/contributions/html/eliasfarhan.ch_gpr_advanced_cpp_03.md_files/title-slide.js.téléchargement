/**
 * GPR Slides - Title Slide Generator
 *
 * Usage: Define window.courseConfig before including this script:
 *
 * <script>
 *   window.courseConfig = {
 *     title: "Your Course Title",
 *     instructor: "Instructor Name",
 *     // Optional overrides:
 *     logo: "images/gpr_logo.png",
 *     avatar: "images/eliasfarhan_circle.png",
 *     background: "images/title_bg.jpg"
 *   };
 * </script>
 * <script src="template/title-slide.js"></script>
 */

(function() {
    // Default configuration
    const defaults = {
        logo: 'images/gpr_logo.png',
        avatar: 'images/eliasfarhan_circle.png',
        background: 'images/title_bg.jpg'
    };

    // Merge with user config
    const config = Object.assign({}, defaults, window.courseConfig || {});

    if (!config.title) {
        console.error('courseConfig.title is required');
        return;
    }

    // Generate title slide HTML
    const titleSlideHTML = `<div style="background-image: url('${config.background}'); background-size: cover; background-position: center; margin: 0 calc(-1 * var(--side-margin)); padding: 0 var(--side-margin); height: var(--slide-height); display: flex; flex-direction: row; justify-content: flex-start; align-items: center;">

<div style="display: flex; flex-direction: column; align-items: center; margin-left: 2rem;">
<div style="position: relative; width: 4.0rem; height: 4.0rem; margin-bottom: 1rem;">
<div style="background: white; border-radius: 50%; width: 98%; height: 98%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"></div>
<img src="${config.logo}" style="height: 4rem; width: 4rem; aspect-ratio: 1/1; object-fit: contain; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
</div>
<img src="${config.avatar}" style="height: 4rem; border-radius: 50%;">
</div>

<div style="margin-left: 3rem; color: white;">
<div style="font-size: 2.5rem; font-weight: bold; margin-bottom: 1rem; line-height: 1.2;">${config.title}</div>
<div style="font-size: 1.4rem;">${config.instructor || ''}</div>
</div>

</div>

---

`;

    // Insert at current script position
    document.write(titleSlideHTML);
})();
