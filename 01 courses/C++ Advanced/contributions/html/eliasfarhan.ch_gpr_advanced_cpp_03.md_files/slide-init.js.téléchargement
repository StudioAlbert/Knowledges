/**
 * GPR Slides - Slide Initialization
 *
 * This script handles all markdeep-slides configuration and initialization.
 * Include at the end of your slide file, after all content.
 *
 * Optional: Define window.slideOptions before including this script to override defaults:
 *
 * <script>
 *   window.slideOptions = {
 *     progressBar: true,
 *     fontSize: 32
 *   };
 * </script>
 * <script src="template/slide-init.js"></script>
 */

(function() {
    // Default slide options
    const defaults = {
        aspectRatio: 16 / 9,
        theme: 'simple',
        fontSize: 28,
        diagramZoom: 1.0,
        totalSlideNumber: false,
        progressBar: false,
        breakOnHeadings: false,
        slideChangeHook: function(oldSlide, newSlide) {},
        modeChangeHook: function(newMode) {}
    };

    // Merge with user options
    window.markdeepSlidesOptions = Object.assign({}, defaults, window.slideOptions || {});

    // Configure markdeep options
    window.markdeepOptions = {
        tocStyle: 'none',
        detectMath: false,
        onLoad: function() {
            initSlides();
        }
    };

    // Write static includes (order matters!)
    document.write(`
<link rel="stylesheet" href="markdeep-slides/lib/markdeep-relative-sizes/1.11/relativize.css">
<link rel="stylesheet" href="markdeep-slides/markdeep-slides.css">
<script src="markdeep-slides/markdeep-slides.js"><\/script>
<script src="slide-utils.js"><\/script>
<style class="fallback">body{visibility:hidden;white-space:pre;font-family:monospace}</style>
<script src="markdeep-slides/lib/markdeep/1.11/markdeep.min.js" charset="utf-8"><\/script>
<script>window.alreadyProcessedMarkdeep||(document.body.style.visibility="visible")<\/script>
`);
})();
